OPENAI_API_KEY=your_gptunnel_api_key
OPENAI_BASE_URL=https://gptunnel.ru/v1
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

KNOWLEDGE_BASE_DIR=data/knowledge_base
